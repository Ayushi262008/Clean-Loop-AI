# ==============================================================================
# EcoTrack Waste Management System - Environment Configuration
# Copy this template to '.env' in the same directory:
#   cp .env.example .env
# ==============================================================================

# Port on which the Express HTTP server listens (Default: 3000)
PORT=3000

# High-entropy cryptographic secret key used for signing & verifying JWT tokens
# Generate a strong 64-character random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-secure-random-secret-key

# Anthropic Claude API Key for Multimodal AI Triage (Optional)
# If left empty, the application uses its built-in rule-based keyword triage engine
ANTHROPIC_API_KEY=

# Anthropic Claude Model Identifier (Default: claude-3-5-sonnet-20241022)
AI_MODEL=claude-3-5-sonnet-20241022

# Default Administrator Account Credentials (Auto-seeded on first server startup)
ADMIN_CONTACT=admin@cleanloop.ai
ADMIN_PASSWORD=admin123
